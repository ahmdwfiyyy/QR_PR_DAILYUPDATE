# Copy this file to ".env" and change the values. Never commit ".env".

# PostgreSQL (the "db" service in docker-compose.yml)
POSTGRES_USER=qr_pr
POSTGRES_PASSWORD=qr_pr
POSTGRES_DB=qr_pr

# Ports on this PC (defaults avoid PO Tracker's 80 / 8000 / 5432)
APP_PORT=8080
API_PORT=8001
DB_PORT=5433

# Items older than this many days are flagged
AGED_DAYS=3

# Largest Excel file accepted
MAX_UPLOAD_MB=10

# Decides what "today" is
APP_TIMEZONE=Asia/Kuala_Lumpur
