.env
.env.*
!.env.example
*.pem
*.key

# ---- Python ----
backend/.venv/
.venv/
__pycache__/
*.pyc

# ---- Node / build output ----
frontend/node_modules/
frontend/dist/
node_modules/

# ---- Logs, OS and editor files ----
*.log
.DS_Store
Thumbs.db
